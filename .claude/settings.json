{
  "permissions": {
    "deny": [
      "Bash(databricks bundle destroy:*)",
      "Bash(databricks bundle deploy --target prod:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/bloquear-sql-perigoso.sh"
          }
        ]
      }
    ]
  }
}
